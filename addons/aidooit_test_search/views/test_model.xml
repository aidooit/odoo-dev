<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View test.model View List -->
    <record id="view_test_model_list" model="ir.ui.view">
        <field name="name">view.test.model.list</field>
        <field name="model">test.model</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- View test.model form -->
    <record id="view_test_model_form" model="ir.ui.view">
        <field name="name">view.test.model.form</field>
        <field name="model">test.model</field>
        <field name="arch" type="xml">
            <form string="Test Model">
                <header>
                    <button name="action_test_search" type="object" string="Test Search"
                        class="oe_highlight" context="{'search_default_test': True}"/>
                    <button name="action_test_search_read" type="object" string="Test Search Read"
                        class="oe_highlight"/>
                    <button name="action_test_search_fetch" type="object" string="Test Search Fetch"
                        class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                    <group>
                        <field name="email"/>
                        <field name="phone"/>
                        <field name="job"/>
                        <field name="age"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action test.model -->
    <record id="action_test_model" model="ir.actions.act_window">
        <field name="name">Test Model</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">test.model</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Test Model.
            </p>
        </field>
    </record>

    <record id="aidooit_test_search.test_menu_root" model="ir.ui.menu">
        <field name="name">Test Search</field>
        <field name="active" eval="True"/>
    </record>

    <menuitem id="test_model_menu"
        name="Test Model"
        action="aidooit_test_search.action_test_model"
        parent="aidooit_test_search.test_menu_root"
        sequence="50"/>

</odoo>
